$("#languageTextarea, #languageTextareaNew, #translationTextarea, #input_tool").keyup(function(a){if(220==a.keyCode||190==a.keyCode){var e=$(this).val().replace(/\||\./g,"।");$(this).val(e)}});
function copyToClipboard(e){if(e="string"==typeof e?document.querySelector(e):e,navigator.userAgent.match(/ipad|ipod|iphone/i)){var t=e.contentEditable,n=e.readOnly,o=document.createRange();e.contentEditable=!0,e.readOnly=!1,o.selectNodeContents(e);var a=window.getSelection();a.removeAllRanges(),a.addRange(o),e.setSelectionRange(0,999999),e.contentEditable=t,e.readOnly=n}else e.select();document.execCommand("copy")}document.getElementById("CopyTool").addEventListener("click",function(e){copyToClipboard(document.getElementsByClassName("copiable")[0])});
